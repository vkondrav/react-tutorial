{
  "name": "playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "cd .. && npx --yes husky",
    "pre:commit": "cd .. && sh .husky/pre-commit",
    "lint": "eslint . --max-warnings 0 --fix",
    "lint:check": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:app": "vite build",
    "build:ssr-client": "vite build --config vite.ssr.config.js",
    "build:ssr-server": "tsc -p tsconfig.server.json",
    "build:storybook": "storybook build",
    "build": "npm run build:app && npm run build:ssr-client && npm run build:ssr-server && npm run build:storybook && npm run build:combine",
    "build:combine": "cp -r storybook-static dist/storybook",
    "dev:storybook": "storybook dev -p 6006 --no-open",
    "dev:server": "node --import tsx server/index.ts",
    "dev:app": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:app\" \"npm run dev:storybook\"",
    "test": "vitest --project=storybook --run",
    "test:watch": "vitest --project=storybook --watch",
    "test:lesson": "f() { vitest --project=storybook --run src/stories/lessons/$1; }; f",
    "msw:install": "npx msw init public --save"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "express": "^5.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.0.0",
    "react-icons": "^5.5.0",
    "react-syntax-highlighter": "^16.1.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^10.1.10",
    "@storybook/addon-docs": "^10.1.10",
    "@storybook/addon-onboarding": "^10.1.10",
    "@storybook/addon-vitest": "^10.1.10",
    "@storybook/react-vite": "^10.1.10",
    "@tailwindcss/vite": "^4.1.17",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "concurrently": "^9.2.1",
    "daisyui": "^5.5.8",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.1.10",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "msw": "^2.12.4",
    "msw-storybook-addon": "^2.0.6",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "storybook": "^10.1.10",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
